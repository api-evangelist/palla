{
  "opencollection": "1.0.0",
  "info": {
    "name": "Palla Platform Partner Accounts Auth API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Auth",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Partner Credential Exchange",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.platform.palla.app/v1/auth/token",
            "headers": [
              {
                "name": "x-palla-request-id",
                "value": ""
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Perform a credentials exchange for a Bearer token. The token authorizes the partner for a specific User with the provided user_id. Call only from the partner's backend; the returned token is safe to hand to a web or native app for subsequent API calls."
        }
      ]
    }
  ],
  "bundled": true
}