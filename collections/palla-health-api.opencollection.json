{
  "opencollection": "1.0.0",
  "info": {
    "name": "Palla Platform Partner Accounts Health API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Health",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Health Check",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.platform.palla.app/healthz"
          },
          "docs": "The healthcheck endpoint for the API proxy."
        }
      ]
    }
  ],
  "bundled": true
}