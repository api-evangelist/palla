{
  "opencollection": "1.0.0",
  "info": {
    "name": "Palla Platform Partner Accounts Transfers API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Transfers",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Transfers",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.platform.palla.app/v1/transfers",
            "headers": [
              {
                "name": "x-palla-request-id",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Page size."
              },
              {
                "name": "offset",
                "value": "",
                "type": "query",
                "description": "Page offset."
              }
            ]
          },
          "docs": "Retrieve a list of all Transfers sent or received by the Account."
        }
      ]
    }
  ],
  "bundled": true
}